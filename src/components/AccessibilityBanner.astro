---
import Icon from '@/components/Icon.astro';
import Mascot from '@/components/Mascot.astro';
import { basePath } from '@/lib/design';
---

<div
  class="pop-card bg-pop-blue text-white p-6 md:p-7 relative overflow-hidden border-2 border-ink shadow-pop-md"
  data-reveal
>
  <!-- Texture a pois leggeri -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.08] [background-image:radial-gradient(var(--color-paper)_2px,transparent_2px)] [background-size:20px_20px]"
    aria-hidden="true"
  ></div>

  <div class="relative flex flex-col lg:flex-row lg:items-center justify-between gap-6">
    <div class="flex items-start sm:items-center gap-4 md:gap-5">
      <div class="hidden sm:flex shrink-0">
        <Mascot name="accessible" size={82} />
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="pop-badge bg-pop-yellow text-ink text-xs font-bold -rotate-1 shadow-pop-sm">
            ♿ Accessibilità Garantita
          </span>
          <span class="pop-badge bg-white text-ink text-xs font-bold rotate-1 shadow-pop-sm">
            Standard WCAG 2.1 AA
          </span>
          <span class="pop-badge bg-pop-mint text-ink text-xs font-bold -rotate-1 shadow-pop-sm">
            Conforme EAA
          </span>
        </div>

        <h3 class="font-display text-lg md:text-xl font-bold text-white tracking-tight">
          Siti web aperti a tutti e conformi alle normative europee.
        </h3>

        <p class="mt-1 text-xs md:text-[13px] text-pop-blue-soft max-w-2xl leading-relaxed">
          Contrasti verificati, navigazione da tastiera e supporto per screen reader: eliminiamo ogni barriera digitale per non perdere clienti e proteggere la tua impresa.
        </p>
      </div>
    </div>

    <div class="shrink-0 flex flex-wrap items-center gap-3">
      <button
        type="button"
        onclick="document.getElementById('a11y-trigger-btn')?.click()"
        class="pop-btn bg-white text-ink hover:bg-neutral-100 text-xs md:text-sm px-4 py-3 font-bold inline-flex items-center gap-2 whitespace-nowrap shadow-pop-sm cursor-pointer"
      >
        ⚙️ Opzioni accessibilità
      </button>
      <a
        href={basePath('/contact')}
        class="pop-btn bg-pop-yellow text-ink hover:bg-pop-yellow-hover text-xs md:text-sm px-5 py-3 font-bold inline-flex items-center gap-2 whitespace-nowrap shadow-pop-sm"
      >
        Richiedi audit per il tuo sito
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
  </div>
</div>
