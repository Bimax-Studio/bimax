---
import Icon from '@/components/Icon.astro';
import { ACCENTS, accentStyle, basePath } from '@/lib/design';

const {
  project,
  index = 0,
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const accent = ACCENTS[project.accent] ?? ACCENTS.solar;
const number = String(index + 1).padStart(2, '0');
---

<a
  href={basePath(`/projects/${project.slug}`)}
  class:list={['group block', className]}
  style={accentStyle(project.accent)}
  data-project-card
  data-accent={project.accent}
  data-accent-hint={`${project.title} — ${accent.label} palette. ${project.summary}`}
>
  <div
    class="bento-lift relative aspect-[4/3] overflow-hidden rounded-2xl border-2 border-ink bg-canvas shadow-[4px_4px_0px_#1A1A1A] transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-[6px_6px_0px_#1A1A1A]"
  >
    {
      project.coverUrl ? (
        <img
          src={project.coverUrl}
          alt={`${project.title} per ${project.client}`}
          width="1200"
          height="900"
          loading={loading}
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 ease-organic group-hover:scale-105"
        />
      ) : (
        <div class="h-full w-full bg-[#FFE8E2] flex items-center justify-center p-6">
          <span class="font-display text-4xl font-black text-ink">
            {project.title}
          </span>
        </div>
      )
    }

    <!-- Numero sticker in alto a sinistra -->
    <span
      class="pop-badge absolute left-3 top-3 bg-white text-ink text-[11px]"
    >
      {number}
    </span>

    <!-- Sticker tonalità in alto a destra -->
    <span
      class="pop-badge absolute right-3 top-3 bg-white text-ink text-xs font-bold"
    >
      <span class="h-2 w-2 rounded-full" style={`background: ${accent.hex}`}></span>
      {project.client}
    </span>

    <!-- Badge hover "Leggi l'articolo" -->
    <span
      class="pop-btn absolute bottom-3 right-3 bg-[#FFD027] text-ink text-xs font-bold py-1.5 px-3 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center gap-1.5"
    >
      Leggi l'articolo
      <Icon name="arrow-up-right" size={13} />
    </span>
  </div>

  <div class="mt-4">
    <div class="flex items-center gap-3">
      <h3 class="display-md text-xl font-bold text-ink shrink-0 group-hover:text-accent transition-colors">
        {project.title}
      </h3>
      <span
        class="h-0.5 flex-1 bg-ink/15 transition-colors group-hover:bg-ink"
        aria-hidden="true"
      ></span>
      <span
        class="grid h-9 w-9 shrink-0 place-items-center rounded-full border-2 border-ink bg-white text-ink transition-all group-hover:bg-[#FFD027] group-hover:shadow-[2px_2px_0px_#1A1A1A]"
      >
        <Icon
          name="arrow-up-right"
          size={15}
          class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </span>
    </div>

    <div class="mt-2 flex flex-wrap items-center gap-2">
      {(project.tags ?? []).slice(0, 3).map((tag) => (
        <span class="font-mono text-xs font-bold text-ink/75 bg-canvas/60 px-2 py-0.5 rounded-md border border-ink/20">
          {tag}
        </span>
      ))}
      {project.year && <span class="font-mono text-xs text-ink/70 ml-auto font-semibold">{project.year}</span>}
    </div>
  </div>

  <p class="mt-2.5 max-w-md text-[14px] leading-relaxed text-ink/75">
    {project.summary}
  </p>
</a>
