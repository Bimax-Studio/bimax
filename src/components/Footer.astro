---
import Icon from '@/components/Icon.astro';
import { SITE, basePath } from '@/lib/design';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Navigazione',
    links: [
      { href: basePath('/projects'), label: 'Progetti & Casi Studio' },
      { href: basePath('/services'), label: 'I 3 Pilastri Operativi' },
      { href: basePath('/about'), label: 'Chi Siamo & Metodo' },
      { href: basePath('/contact'), label: 'Richiedi un Audit' },
      { href: basePath('/privacy'), label: 'Privacy Policy' },
    ],
  },
  {
    title: 'Territorio & PMI',
    links: [
      { href: basePath('/territorio/verona'), label: 'Verona Centro & ZAI' },
      { href: basePath('/territorio/lago-di-garda'), label: 'Lago di Garda' },
      { href: basePath('/territorio/valpolicella'), label: 'Valpolicella' },
      { href: basePath('/territorio/villafranca'), label: 'Villafranca & Pianura' },
      { href: basePath('/territorio/san-bonifacio'), label: 'San Bonifacio & Soave' },
      { href: basePath('/territorio/bussolengo'), label: 'Bussolengo & Valdadige' },
    ],
  },
];
---

<footer class="relative overflow-hidden bg-ink text-paper">
  <div
    class="bg-[#a58100] shadow-[6px_6px_0px_#1A1A1A] pointer-events-none absolute -right-40 -top-40 h-[30rem] w-[30rem] rounded-full opacity-90"
    aria-hidden="true"
  ></div>

  <div
    class="relative mx-auto max-w-[1400px] px-[var(--page-gutter)] pb-10 pt-20 md:pt-28"
  >
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <h2 class="display-lg max-w-[14ch]">
          Parliamo del tuo progetto a <span class="text-accent">Verona</span>
        </h2>
        <p class="mt-6 max-w-lg text-[15px] leading-relaxed text-paper/70">
          Hai già delle campagne attive o un sito che non porta contatti?
          Mandaci il link: controlleremo velocità, visibilità locale e tracciamenti
          per dirti esattamente cosa sistemare.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={SITE.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="pop-btn bg-[#25D366] text-ink hover:bg-[#20ba5a] flex items-center gap-2 px-5 py-3 text-[14px] font-bold border-2 border-white shadow-[3px_3px_0px_#FFFFFF]"
          >
            <Icon name="whatsapp" size={17} />
            Scrivici su WhatsApp
            <span class="text-xs opacity-90">(dialogo diretto)</span>
          </a>
          <a
            href={basePath('/contact')}
            class="pop-btn bg-white text-ink hover:bg-neutral-100 px-5 py-3 text-[14px] font-bold border-2 border-white shadow-[3px_3px_0px_#FFFFFF]"
          >
            Compila il modulo rapido
          </a>
        </div>

        <div class="mt-10 flex items-center gap-2 text-xs text-paper/70 font-medium">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          Partner digitali per le PMI — Nessun intermediario commerciale
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-5">
        {
          columns.map((column) => (
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.16em] text-paper/70 font-bold">
                {column.title}
              </p>
              <ul class="mt-5 space-y-2.5">
                {column.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="link-underline text-[13px] text-paper/85 transition-colors hover:text-paper"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div>
          <p class="font-mono text-xs uppercase tracking-[0.16em] text-paper/70 font-bold">
            Sede Operativa
          </p>
          <address class="mt-5 not-italic text-[13px] leading-relaxed text-paper/80">
            {SITE.address}<br />
            {SITE.city}
          </address>
          <a
            href={`tel:${SITE.phoneRaw}`}
            class="link-underline mt-4 inline-block text-[13px] text-paper/90 font-mono"
          >
            {SITE.phone}
          </a>
          <div class="mt-2">
            <a
              href={`mailto:${SITE.email}`}
              class="link-underline inline-block text-[13px] text-paper/90 font-mono"
            >
              {SITE.email}
            </a>
          </div>
        </div>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col justify-between gap-4 border-t border-paper/10 pt-8 sm:flex-row sm:items-center font-mono text-xs text-paper/70"
    >
      <p>
        © {year} {SITE.name}. Sviluppo web performante e local SEO a Verona.
      </p>
      <div class="flex items-center gap-5">
        <a href={basePath('/privacy')} class="hover:text-paper font-semibold">Privacy Policy</a>
        <a href={basePath('/contact')} class="hover:text-paper font-semibold">Audit Gratuito</a>
      </div>
    </div>
  </div>
</footer>
