---
import Icon from '@/components/Icon.astro';

const {
  eyebrow,
  title,
  description,
  action,
  align = 'left',
  class: className = '',
} = Astro.props;
---

<div
  class:list={[
    'flex flex-col gap-8 md:flex-row md:items-end md:justify-between',
    align === 'center' && 'md:flex-col md:items-center md:text-center',
    className,
  ]}
>
  <div class:list={['max-w-3xl', align === 'center' && 'md:mx-auto']}>
    {
      eyebrow && (
        <p class="eyebrow flex items-center gap-2 text-ink/60">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" />
          {eyebrow}
        </p>
      )
    }
    <h2 class="display-lg mt-4 text-balance">{title}</h2>
    {
      description && (
        <p class="mt-5 max-w-xl text-[15px] leading-relaxed text-ink/60">
          {description}
        </p>
      )
    }
  </div>

  {
    action && (
      <a
        href={action.href}
        class="group inline-flex shrink-0 items-center gap-3 self-start rounded-full border border-black/10 px-5 py-3 text-[13px] font-medium transition-colors hover:border-black/30 md:self-auto"
      >
        {action.label}
        <Icon
          name="arrow-up-right"
          size={15}
          class="arrow text-ink/60 transition-colors group-hover:text-ink"
        />
      </a>
    )
  }
</div>
