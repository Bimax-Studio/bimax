---
import '@/styles/global.css';

import AccessibilityWidget from '@/components/AccessibilityWidget.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { SITE, basePath } from '@/lib/design';

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  image = '/og.svg',
  accent = 'solar',
  ogType = 'website',
  noindex = false,
  bodyClass = '',
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(basePath(image), site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === (import.meta.env.BASE_URL || '/');

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.legalName,
  url: site.origin,
  email: SITE.email,
  foundingDate: String(SITE.founded),
  description: SITE.description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address,
    addressLocality: 'Verona',
    addressRegion: 'VR',
    addressCountry: 'IT',
  },
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={basePath('/favicon.svg')} type="image/svg+xml" />
    <meta name="site-base" content={import.meta.env.BASE_URL || '/'} />
    <meta name="theme-color" content="#D63914" />
    <meta name="color-scheme" content="light" />

    <script is:inline>
      // Automatic link resolver for GitHub Pages subpath
      (function() {
        const base = document.querySelector('meta[name="site-base"]')?.getAttribute('content') || '/';
        if (base && base !== '/') {
          document.addEventListener('click', function(e) {
            const a = e.target.closest('a');
            if (!a) return;
            const href = a.getAttribute('href');
            if (href && href.startsWith('/') && !href.startsWith(base) && !href.startsWith('//')) {
              a.setAttribute('href', base + href.slice(1));
            }
          }, true);
        }
      })();
    </script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="it_IT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Manrope:wght@400..800&family=Space+Mono:ital,wght@0,400;0,700&display=swap"
    />

    {
      isHome && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(organization)}
        />
      )
    }

    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        const prefs = JSON.parse(localStorage.getItem('bimax:a11y_prefs') || '{}');
        const root = document.documentElement;
        if (prefs.fontSize === 'lg') root.classList.add('a11y-text-lg');
        if (prefs.fontSize === 'xl') root.classList.add('a11y-text-xl');
        if (prefs.contrast === 'high') root.classList.add('a11y-high-contrast');
        if (prefs.contrast === 'grayscale') root.classList.add('a11y-grayscale');
        if (prefs.readableFont) root.classList.add('a11y-readable-font');
        if (prefs.textSpacing) root.classList.add('a11y-text-spacing');
        if (prefs.underlineLinks) root.classList.add('a11y-underline-links');
        if (prefs.stopAnimations) root.classList.add('a11y-stop-animations');
      } catch (e) {}
    </script>
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#swup">Salta al contenuto</a>

    <div class="grain-layer" aria-hidden="true"></div>

    <Header />

    <main id="swup" class="transition-swup" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <AccessibilityWidget />

    <script src="@/scripts/swup-init.js"></script>
  </body>
</html>
