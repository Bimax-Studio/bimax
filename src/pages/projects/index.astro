---
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Layout from '@/layouts/Layout.astro';
import { getProjects } from '@/lib/content';
import { SITE } from '@/lib/design';

const projects = await getProjects();
---

<Layout
  title="Progetti Realizzati — BIMAX Verona"
  description="I siti web che abbiamo realizzato per aziende e professionisti di Verona e provincia: veloci da cellulare, presenti su Google Maps e facili da gestire."
>
  <section class="relative overflow-hidden pt-12 pb-16 md:pt-18 md:pb-22 bg-paper">
    <!-- Texture a pois leggeri -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.06] [background-image:radial-gradient(var(--color-ink)_2px,transparent_2px)] [background-size:24px_24px]"
      aria-hidden="true"
    ></div>

    <div
      class="relative mx-auto max-w-[1360px] px-[var(--page-gutter)]"
    >
      <div class="flex flex-wrap items-center gap-2.5 mb-6">
        <span class="pop-badge bg-pop-yellow text-ink -rotate-1">
          💻 Progetti sul territorio
        </span>
        <span class="pop-badge bg-pop-mint text-ink rotate-1">
          ⚡ Massima velocità
        </span>
        <span class="pop-badge bg-pop-coral-soft text-pop-coral -rotate-2">
          📍 Verona e provincia
        </span>
      </div>

      <div class="mt-4 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <h1 class="display-xl max-w-[15ch] text-balance text-ink">
            Progetti realizzati con cura e attenzione sul territorio.
          </h1>
          <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-ink/80 md:text-[18px]">
            I siti web e le presenze digitali che abbiamo sviluppato per le attività locali: come abbiamo eliminato la lentezza del vecchio sito, impostato la presenza su Google Maps e aperto un canale diretto con i clienti.
          </p>
        </div>

        <div class="lg:col-span-4">
          <div class="pop-card bg-pop-yellow-soft p-5">
            <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-ink/75">
              Il nostro approccio
            </p>
            <p class="mt-2 text-xs leading-relaxed text-ink/80">
              Ogni progetto nasce per risolvere problemi concreti: tempi di caricamento infiniti da smartphone, assenza su Google Maps e difficoltà ad aggiornare i contenuti.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-[var(--page-gutter)] py-16 md:py-24 border-t-2 border-ink/10">
    <div class="mx-auto max-w-[1360px]">
      <h2 class="sr-only">Tutti i progetti realizzati</h2>
      {
        projects.length === 0 ? (
          <div class="pop-card flex min-h-64 flex-col items-center justify-center gap-4 p-10 text-center bg-white">
            <Icon name="spark" size={24} class="text-accent" />
            <p class="display-md text-ink">Nessun progetto trovato.</p>
            <p class="max-w-sm text-sm text-ink/60">
              I progetti sono in fase di aggiornamento.
            </p>
          </div>
        ) : (
          <div class="grid gap-x-8 gap-y-14 md:grid-cols-12 md:gap-y-18">
            {projects.map((project, index) => (
              <div
                class:list={[
                  'md:col-span-6',
                  index % 4 === 1 && 'md:pt-10',
                  index % 4 === 2 && 'md:col-start-2',
                  index % 4 === 3 && 'md:pt-10',
                ]}
                data-reveal
                style={`--reveal-delay: ${(index % 2) * 80}ms`}
              >
                <ProjectCard
                  project={project}
                  index={index}
                  loading={index < 2 ? 'eager' : 'lazy'}
                />
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <CtaBand
    title="Vuoi dare nuova linfa al tuo sito a Verona?"
    description="Inviaci il link del tuo sito web attuale: controlleremo con calma velocità reale da smartphone, visibilità su Google Maps e tracciamenti per spiegarti con sincerità cosa sistemare."
    primary={{ label: 'Scrivici su WhatsApp', href: SITE.whatsappUrl, isExternal: true }}
    secondary={{ label: 'Compila il modulo contatti breve', href: '/contact' }}
  />
</Layout>
