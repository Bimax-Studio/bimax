---
import AccessibilityBanner from '@/components/AccessibilityBanner.astro';
import Icon from '@/components/Icon.astro';
import Mascot from '@/components/Mascot.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import Layout from '@/layouts/Layout.astro';
import { getProjects, getServices } from '@/lib/content';
import { SITE, basePath } from '@/lib/design';
import { TERRITORI } from '@/data/territori';

const [projects, services] = await Promise.all([getProjects(), getServices()]);

const featured = projects.filter((project) => project.featured);
const work = featured.length > 0 ? featured : projects.slice(0, 3);

const guarantees = [
  {
    title: 'Navigabilità fluida da smartphone',
    description: 'Piattaforme leggere e veloci senza template pesanti, pensate per chi naviga da cellulare.',
    icon: 'smartphone',
    mascot: 'speedy',
    badgeColor: 'bg-pop-yellow text-ink',
  },
  {
    title: 'Visibilità su Google Maps & ricerca locale',
    description: 'Presenza curata della scheda Google e informazioni chiare per farsi trovare sul territorio.',
    icon: 'map-pin',
    mascot: 'scout',
    badgeColor: 'bg-pop-mint text-ink',
  },
  {
    title: 'Tracciamento reale di contatti e telefonate',
    description: 'Misuriamo ogni click verso WhatsApp, chiamate e richieste per verificare quanti contatti arrivano.',
    icon: 'activity',
    mascot: 'whatsapp-buddy',
    badgeColor: 'bg-pop-purple text-white',
  },
  {
    title: 'Un partner diretto, zero intermediari',
    description: 'Dialogo continuo con chi realizza e sviluppa il tuo progetto. Niente commerciali o passaggi a vuoto.',
    icon: 'shield-check',
    mascot: 'coder',
    badgeColor: 'bg-pop-coral text-white',
  },
];

const painPoints = [
  {
    title: 'Siti lenti e ingestibili',
    description:
      'Spesso realizzati con template generici pieni di plugin superflui che rallentano la navigazione da mobile e si rompono a ogni aggiornamento.',
    icon: 'zap',
    bg: 'bg-pop-yellow-soft',
    badge: '🐌 Sito lento = cliente che cambia idea',
  },
  {
    title: 'Invisibili sul territorio',
    description:
      'Avere un bel sito serve a poco se i clienti della tua zona (Verona, lago o provincia) faticano a trovare la tua attività quando cercano un servizio su Google o Maps.',
    icon: 'map-pin',
    bg: 'bg-pop-coral-soft',
    badge: '🗺️ Presenza locale da curare',
  },
  {
    title: 'Zero controllo sui dati',
    description:
      'Molte aziende investono budget in pubblicità online ma non sanno quante telefonate o messaggi WhatsApp arrivano effettivamente dal sito web.',
    icon: 'activity',
    bg: 'bg-pop-mint-soft',
    badge: '💸 Budget speso senza riscontri',
  },
];

const processSteps = [
  {
    step: '01',
    title: 'Analisi & Obiettivi',
    body: 'Esaminiamo cosa fa la tua attività, chi sono i tuoi clienti e quali canali di contatto funzionano meglio sul territorio.',
    color: 'bg-pop-yellow',
  },
  {
    step: '02',
    title: 'Sviluppo Tecnico & Semplicità',
    body: 'Piattaforma veloce, Pannello di gestione semplice, Ottimizzazione mobile.',
    color: 'bg-pop-mint',
  },
  {
    step: '03',
    title: 'Scheda Google & Trasparenza Dati',
    body: 'Scheda Google, Trasparenza dati e integrazioni Campagne marketing (se necessari).',
    color: 'bg-pop-purple text-white',
  },
  {
    step: '04',
    title: 'Messa Online & Continuità',
    body: "Pubblicazione sul dominio, formazione pratica sull'uso dell'admin e supporto per far crescere la tua attività.",
    color: 'bg-pop-coral text-white',
  },
];

const maintenancePoints = [
  {
    title: 'Aggiornare testi e foto in 2 minuti',
    description:
      'Niente pannelli complicati tipo cockpit di un aereo. Hai un admin pulito ed essenziale: cambi un orario, carichi le foto dei nuovi lavori o aggiorni i servizi in due clic, anche da cellulare.',
    icon: 'zap',
    badge: '⏱️ Tempo medio: 2 min',
  },
  {
    title: 'Indicazioni chiare su cosa fare',
    description:
      'Non ti lasciamo solo davanti al sito. Ti diamo noi indicazioni pratiche: cosa pubblicare sui social, come tenere viva la scheda Google Maps e quando vale la pena fare un aggiornamento, senza farti perdere ore.',
    icon: 'compass',
    badge: '📋 Istruzioni pratiche',
  },
  {
    title: 'Nessun vincolo, supporto umano al volo',
    description:
      'Non ti facciamo pagare canoni per cambiare una frase. Il sito è tuo al 100%. E se hai un dubbio o vuoi una mano, ci mandi un messaggio su WhatsApp e rispondiamo noi direttamente.',
    icon: 'shield-check',
    badge: '💬 WhatsApp diretto',
  },
];

const territoryStickers = [
  { name: 'Verona Centro & ZAI', slug: 'verona', color: 'bg-pop-yellow' },
  { name: 'Lago di Garda', slug: 'lago-di-garda', color: 'bg-pop-mint' },
  { name: 'Valpolicella', slug: 'valpolicella', color: 'bg-pop-coral-soft' },
  { name: 'Villafranca', slug: 'villafranca', color: 'bg-pop-purple text-white' },
  { name: 'San Bonifacio', slug: 'san-bonifacio', color: 'bg-pop-blue text-white' },
  { name: 'Bussolengo', slug: 'bussolengo', color: 'bg-pop-yellow' },
];
---

<Layout
  title="BIMAX — Siti web e strategie digitali per PMI a Verona e provincia"
  description="Partner digitale per le PMI: sviluppiamo piattaforme snelle, miglioriamo la presenza su Google Maps e colleghiamo i canali commerciali per generare contatti reali."
>
  <!-- ============================================================== -->
  <!-- 1. HERO: ECCENTRICA, COLORATA, UMANA & CON MASCOTTE           -->
  <!-- ============================================================== -->
  <section class="relative overflow-hidden pt-10 pb-16 md:pt-16 md:pb-24 bg-paper">
    <!-- Texture a pois leggeri di sottofondo -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.06] [background-image:radial-gradient(var(--color-ink)_2px,transparent_2px)] [background-size:24px_24px]"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-[1360px] px-[var(--page-gutter)]">
      <!-- Riga Sticker in alto -->
      <div class="flex flex-wrap items-center gap-2.5 mb-6">
        <span class="pop-badge bg-pop-yellow text-ink -rotate-1">
          📍 Verona & Territorio PMI
        </span>
        <span class="pop-badge bg-pop-mint text-ink rotate-1">
          🤝 Partner Diretto, Zero Venditori
        </span>
        <span class="pop-badge bg-pop-coral-soft text-ink -rotate-2">
          💡 La tecnologia al servizio del business
        </span>
      </div>

      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
        <!-- Colonna Testo Principale -->
        <div class="lg:col-span-7 xl:col-span-8">
          <h1 class="display-xl text-ink max-w-[15ch] text-balance">
            Siti web veloci e strategie digitali per far crescere le PMI.
          </h1>

          <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-ink/80 md:text-[18px]">
            Niente template pesanti o siti abbandonati a se stessi. Sviluppiamo piattaforme snelle, miglioriamo la visibilità locale su Google Maps e colleghiamo i tuoi canali promozionali per trasformare le visite in chiamate e contatti reali per la tua impresa.
          </p>

          <!-- Bottoni Pop -->
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={SITE.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="pop-btn bg-pop-green text-ink hover:bg-pop-green-hover text-base px-7 py-4"
            >
              <Icon name="whatsapp" size={20} />
              Richiedi audit via WhatsApp
              <span class="text-xs font-mono opacity-80">(dialogo diretto)</span>
            </a>

            <a
              href={basePath('/contact')}
              class="pop-btn bg-paper text-ink hover:bg-pop-yellow-soft text-base px-6 py-4"
            >
              Compila il modulo rapido
              <Icon name="arrow-right" size={16} />
            </a>
          </div>

          <!-- Micro nota di trasparenza -->
          <p class="mt-4 text-xs text-ink/80 font-mono flex items-center gap-1.5">
            <span>(ツ)</span> Mandaci il link della tua attività: esaminiamo velocità da smartphone, presenza su Maps e tracciamenti senza alcun impegno.
          </p>
        </div>

        <!-- Colonna Mascotte con Fumetto Parlante -->
        <div class="lg:col-span-5 xl:col-span-4 flex flex-col items-center">
          <div class="relative w-full max-w-[340px] text-center">
            <!-- Fumetto parlante pop -->
            <div class="pop-card bg-pop-yellow-soft p-4 mb-4 text-left relative rotate-1">
              <p class="font-display font-bold text-sm text-ink leading-snug">
                "Partner al tuo fianco, non solo tecnici."
              </p>
              <p class="text-xs text-ink/75 mt-1 leading-relaxed">
                La tecnologia è il nostro strumento per supportare la tua attività e far crescere il tuo business. Parli direttamente con noi, senza intermediari o commerciali.
              </p>
              <!-- Freccina del fumetto -->
              <div class="absolute -bottom-3 left-16 w-5 h-5 bg-pop-yellow-soft border-r-2 border-b-2 border-ink transform rotate-45"></div>
            </div>

            <!-- Mascotte sviluppatore/partner -->
            <Mascot name="coder" size={210} class="mx-auto" />

            <div class="mt-2 inline-flex items-center gap-2 bg-white px-4 py-1.5 rounded-full border-2 border-ink shadow-pop-sm font-mono text-xs font-bold">
              <span class="h-2 w-2 rounded-full bg-pop-mint"></span>
              Al fianco delle PMI
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================================ -->
      <!-- BADGE DI GARANZIA / PUNTI FERMI SOTTO LA HERO                -->
      <!-- ============================================================ -->
      <div class="mt-14 pt-10 border-t-2 border-ink/15">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            guarantees.map((item, idx) => (
              <div
                class:list={[
                  'pop-card p-5 flex flex-col justify-between transition-transform',
                  idx % 2 === 0 ? '-rotate-0.5' : 'rotate-0.5',
                ]}
              >
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class={`grid h-10 w-10 place-items-center rounded-xl border-2 border-ink shadow-pop-sm ${item.badgeColor}`}>
                      <Icon name={item.icon} size={18} />
                    </span>
                    <Mascot name={item.mascot} size={46} />
                  </div>
                  <p class="font-display text-[15px] font-bold leading-snug text-ink">
                    {item.title}
                  </p>
                  <p class="mt-2 text-[13px] leading-relaxed text-ink/70">
                    {item.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- STRISCIA TERRITORIO ADESIVI COLORATI CLICCABILI -->
  <div class="border-y-2 border-ink bg-pop-yellow-soft py-4 overflow-hidden">
    <div class="mx-auto max-w-[1360px] px-[var(--page-gutter)]">
      <div class="flex flex-wrap items-center justify-center gap-3">
        <span class="font-mono text-xs uppercase tracking-[0.14em] font-bold text-ink mr-2">
          Dove siamo attivi a Verona e provincia:
        </span>
        {
          territoryStickers.map((sticker, idx) => (
            <a
              href={basePath(`/territorio/${sticker.slug}`)}
              class:list={[
                'pop-badge text-ink hover:scale-105 transition-transform text-xs font-bold',
                sticker.color,
                idx % 2 === 0 ? 'rotate-1' : '-rotate-1',
              ]}
            >
              📍 {sticker.name} →
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ============================================================== -->
  <!-- 2. IL PROBLEMA DEL CLIENTE LOCALE (PAIN POINTS)                -->
  <!-- ============================================================== -->
  <section class="border-b-2 border-ink bg-canvas px-[var(--page-gutter)] py-20 md:py-26">
    <div class="mx-auto max-w-[1360px]">
      <div class="max-w-2xl" data-reveal>
        <span class="pop-badge bg-ink text-white -rotate-1 mb-4">
          I problemi più comuni
        </span>
        <h2 class="display-lg mt-3 text-ink">
          Perché molti siti web aziendali non portano contatti?
        </h2>
        <p class="mt-4 text-[16px] leading-relaxed text-ink/75">
          Spendere per un sito che non genera chiamate o richieste è un problema comune a tante attività locali. Ecco i tre veri ostacoli che vediamo tutti i giorni:
        </p>
      </div>

      <div class="mt-12 grid gap-7 md:grid-cols-3" data-reveal>
        {
          painPoints.map((item, index) => (
            <div
              class:list={[
                'pop-card p-7 flex flex-col justify-between transition-transform',
                item.bg,
                index === 1 ? 'rotate-1' : '-rotate-1',
              ]}
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <div>
                <span class="pop-badge bg-white text-ink text-xs mb-4">
                  {item.badge}
                </span>

                <h3 class="font-display text-2xl font-bold text-ink mt-2">
                  {item.title}
                </h3>

                <p class="mt-3.5 text-[14px] leading-relaxed text-ink/80">
                  {item.description}
                </p>
              </div>

              <div class="mt-6 pt-3 border-t-2 border-ink/20 flex items-center justify-between">
                <span class="font-mono text-xs font-bold text-ink">Problema #{index + 1}</span>
                <span class="text-xs font-bold text-ink">Noi lo eliminiamo ➔</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 3. I SERVIZI: COSA FACCIAMO PER LA TUA ATTIVITÀ               -->
  <!-- ============================================================== -->
  <section class="border-b-2 border-ink bg-paper px-[var(--page-gutter)] py-20 md:py-28">
    <div class="mx-auto max-w-[1360px]">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
        <div class="max-w-2xl">
          <span class="pop-badge bg-pop-mint text-ink -rotate-1 mb-4">
            Cosa Facciamo
          </span>
          <h2 class="display-lg mt-3">
            Servizi pratici e orientati ai contatti reali
          </h2>
          <p class="mt-4 text-[16px] leading-relaxed text-ink/75">
            Tre soluzioni coordinate, pensate per dare valore concreto alla tua impresa senza costi inutili o complicazioni tecniche.
          </p>
        </div>

        <a href={basePath('/services')} class="pop-btn bg-pop-yellow text-ink text-xs px-5 py-3">
          Esplora tutti i dettagli
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <!-- Schede Servizi colorate -->
      <div class="mt-14 space-y-8" data-reveal>
        {
          services.map((service, index) => {
            const colors = [
              { bg: 'bg-pop-yellow-soft', accent: 'bg-pop-yellow text-ink', mascot: 'speedy' },
              { bg: 'bg-pop-mint-soft', accent: 'bg-pop-mint text-ink', mascot: 'scout' },
              { bg: 'bg-pop-purple-soft', accent: 'bg-pop-purple text-white', mascot: 'whatsapp-buddy' },
            ];
            const col = colors[index % colors.length];

            return (
              <article
                id={service.slug}
                class:list={[
                  'pop-card p-7 md:p-9 transition-transform',
                  col.bg,
                ]}
              >
                <div class="grid gap-8 md:grid-cols-12 md:items-center">
                  <div class="md:col-span-8">
                    <div class="flex items-center gap-3">
                      <span class={`pop-badge ${col.accent} text-xs`}>
                        {service.kicker}
                      </span>
                    </div>

                    <h3 class="display-md mt-4 text-2xl md:text-3xl text-ink">
                      {service.title}
                    </h3>

                    <p class="mt-3.5 text-[15px] leading-relaxed text-ink/80 max-w-xl">
                      {service.summary}
                    </p>

                    <div class="mt-6 flex flex-wrap gap-2">
                      {(service.features ?? []).map((feat) => (
                        <span class="inline-flex items-center gap-1.5 rounded-lg border border-ink/20 bg-white/80 px-2.5 py-1 text-xs font-medium text-ink">
                          <span class="text-pop-mint font-bold">✓</span>
                          {feat}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div class="md:col-span-4 flex flex-col items-center justify-center">
                    <Mascot name={col.mascot} size={135} />
                    <a
                      href={basePath(`/services#${service.slug}`)}
                      class="pop-btn bg-white text-ink text-xs px-4 py-2 mt-3 hover:bg-pop-yellow"
                    >
                      Scopri di più →
                    </a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 4. IL METODO DI LAVORO (4 STEP)                                -->
  <!-- ============================================================== -->
  <section class="border-b-2 border-ink bg-canvas px-[var(--page-gutter)] py-20 md:py-28">
    <div class="mx-auto max-w-[1360px]">
      <div class="max-w-2xl" data-reveal>
        <span class="pop-badge bg-pop-yellow text-ink -rotate-1 mb-4">
          Come lavoriamo
        </span>
        <h2 class="display-lg mt-3 text-ink">
          Il Metodo di Lavoro in 4 Step
        </h2>
        <p class="mt-4 text-[16px] leading-relaxed text-ink/75">
          Un percorso chiaro e trasparente per consegnarti uno strumento snello e pronto a portare risultati, senza promesse teoriche.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
        {
          processSteps.map((step, idx) => (
            <div
              class="pop-card bg-white p-6 flex flex-col justify-between"
              style={`--reveal-delay: ${idx * 60}ms`}
            >
              <div>
                <span
                  class={`inline-block font-mono text-sm font-black px-3 py-1 rounded-xl border-2 border-ink ${step.color} shadow-pop-sm`}
                >
                  {step.step}
                </span>

                <h3 class="font-display text-lg font-bold text-ink mt-4">
                  {step.title}
                </h3>

                <p class="mt-3 text-[14px] leading-relaxed text-ink/75">
                  {step.body}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- FACILE DA MANTENERE NEL TEMPO (ZERO ANSIE POST-LANCIO)         -->
  <!-- ============================================================== -->
  <section class="border-b-2 border-ink bg-pop-mint-soft px-[var(--page-gutter)] py-20 md:py-26">
    <div class="mx-auto max-w-[1360px]">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
        <div class="max-w-2xl">
          <span class="pop-badge bg-white text-ink -rotate-1 mb-4">
            Zero ansie post-lancio
          </span>
          <h2 class="display-lg mt-3 text-ink">
            Facile da mantenere nel tempo. Senza mal di testa.
          </h2>
          <p class="mt-4 text-[16px] leading-relaxed text-ink/85">
            Molte aziende temono di rifare il sito per la paura di restare intrappolate con sistemi ingestibili o di dover pagare l'agenzia a ogni minima modifica. Con noi è diverso: ti diamo noi indicazioni chiarissime su cosa fare e un pannello elementare.
          </p>
        </div>

        <a
          href={SITE.whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="pop-btn bg-pop-green text-ink hover:bg-pop-green-hover text-xs px-5 py-3 font-bold"
        >
          <Icon name="whatsapp" size={16} />
          Chiedici come funziona
        </a>
      </div>

      <div class="mt-14 grid gap-7 md:grid-cols-3" data-reveal>
        {
          maintenancePoints.map((item, idx) => (
            <div
              class="pop-card bg-white p-7 flex flex-col justify-between transition-transform hover:-translate-y-1"
              style={`--reveal-delay: ${idx * 70}ms`}
            >
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="grid h-10 w-10 place-items-center rounded-xl border-2 border-ink bg-pop-yellow text-ink shadow-pop-sm">
                    <Icon name={item.icon} size={18} />
                  </span>
                  <span class="pop-badge bg-canvas text-ink text-xs font-bold">
                    {item.badge}
                  </span>
                </div>

                <h3 class="font-display text-xl font-bold text-ink">
                  {item.title}
                </h3>

                <p class="mt-3.5 text-[14px] leading-relaxed text-ink/80">
                  {item.description}
                </p>
              </div>

              <div class="mt-6 pt-3 border-t-2 border-ink/10 text-xs font-mono font-bold text-ink/75">
                ✓ Senza complicazioni
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- PICCOLO BANNER BLU: ACCESSIBILITÀ & CONFORMITÀ (WCAG/EAA)      -->
  <!-- ============================================================== -->
  <section class="border-b-2 border-ink bg-canvas px-[var(--page-gutter)] py-8">
    <div class="mx-auto max-w-[1360px]">
      <AccessibilityBanner />
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- PROGETTI REALIZZATI SUL TERRITORIO                             -->
  <!-- ============================================================== -->
  <section
    id="work"
    class="border-b-2 border-ink bg-paper px-[var(--page-gutter)] py-20 md:py-28"
  >
    <div class="mx-auto max-w-[1360px]">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end" data-reveal>
        <div class="max-w-2xl">
          <span class="pop-badge bg-pop-yellow text-ink -rotate-1 mb-4">
            I lavori recenti
          </span>
          <h2 class="display-lg mt-3">
            Progetti realizzati con cura e attenzione sul territorio
          </h2>
          <p class="mt-4 text-[16px] leading-relaxed text-ink/75">
            I siti web che abbiamo realizzato per le aziende locali: pagine veloci da smartphone, scheda Google Maps a posto e canali diretti per farsi contattare.
          </p>
        </div>

        <a href={basePath('/projects')} class="pop-btn bg-white text-ink text-xs px-5 py-3 hover:bg-pop-yellow">
          Tutti i progetti
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <div class="mt-14 grid gap-x-8 gap-y-14 md:grid-cols-12">
        {
          work.map((project, index) => (
            <div
              class:list={[
                'md:col-span-6',
                index === 1 && 'md:col-span-6 md:pt-8',
                index === 2 && 'md:col-span-8 md:col-start-3',
              ]}
              data-reveal
              style={`--reveal-delay: ${index * 70}ms`}
            >
              <ProjectCard
                project={project}
                index={index}
                loading={index === 0 ? 'eager' : 'lazy'}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 5. CHI SIAMO / APPROCCIO (PARTNER STRATEGICO PER PMI)          -->
  <!-- ============================================================== -->
  <section class="border-b-2 border-ink bg-pop-yellow-soft px-[var(--page-gutter)] py-20 md:py-28">
    <div class="mx-auto max-w-[1360px]">
      <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7" data-reveal>
          <span class="pop-badge bg-ink text-white -rotate-1 mb-4">
            Partner Digitale per PMI
          </span>
          <h2 class="display-lg mt-3 text-ink">
            Il partner che unisce visione aziendale e controllo tecnico
          </h2>

          <div class="mt-7 max-w-xl space-y-4 text-[16px] leading-relaxed text-ink/85">
            <p>
              Non siamo semplici programmatori che scrivono codice e basta: siamo un partner al fianco delle PMI. La tecnologia è il nostro strumento, ma l'obiettivo prioritario è far crescere la tua attività, migliorare l'efficienza e portare richieste di contatto reali.
            </p>
            <p>
              Offriamo alle aziende di Verona, provincia e territori vicini un dialogo diretto e trasparente: nessun venditore o intermediario commerciale a fare da filtro, parli direttamente con chi cura la strategia, progetta i sistemi e sviluppa la tua piattaforma.
            </p>
          </div>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a href={basePath('/about')} class="pop-btn bg-ink text-white hover:bg-accent text-sm px-6 py-3.5">
              Scopri chi siamo & il nostro metodo
              <Icon name="arrow-right" size={14} />
            </a>
            <a
              href={`tel:${SITE.phoneRaw}`}
              class="pop-btn bg-white text-ink text-sm px-5 py-3.5 hover:bg-pop-yellow"
            >
              <Icon name="phone" size={14} />
              Chiamaci: {SITE.phone}
            </a>
          </div>
        </div>

        <div class="lg:col-span-5" data-reveal style="--reveal-delay: 80ms">
          <div class="pop-card bg-white p-7 text-center rotate-1">
            <Mascot name="cup" size={140} class="mx-auto" />
            <h3 class="font-display text-xl font-bold text-ink mt-3">
              Due chiacchiere con un caffè alla mano?
            </h3>
            <p class="text-xs text-ink/75 mt-2 leading-relaxed">
              Non abbiamo un ufficio formale: lavoriamo da remoto e sul territorio. Ci prendiamo volentieri un caffè virtuale in chiamata o al bar se siamo in zona per lavoro. Nessun venditore, nessun vincolo.
            </p>
            <div class="mt-4 pt-3 border-t border-black/10">
              <a
                href={SITE.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="pop-btn bg-pop-green text-ink text-xs px-4 py-2 w-full font-bold"
              >
                💬 Scrivici: facciamo due chiacchiere con un caffè
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================== -->
  <!-- 6. CALL TO ACTION FINALE POP                                   -->
  <!-- ============================================================== -->
  <section class="px-[var(--page-gutter)] py-20 md:py-28 bg-canvas">
    <div
      class="pop-card bg-ink text-white mx-auto max-w-[1360px] p-8 md:p-14 -rotate-0.5"
      data-reveal
    >
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-8">
          <span class="pop-badge bg-pop-yellow text-ink -rotate-1 mb-4 inline-block">
            Confronto Gratuito
          </span>
          <h2 class="display-lg max-w-[14ch] text-white mt-2">
            Parliamo del tuo progetto a <span class="text-pop-yellow">Verona</span>
          </h2>
          <p class="mt-4 max-w-lg text-[16px] leading-relaxed text-white/90">
            Hai già delle campagne attive o un sito che non porta contatti? Mandaci il link: controlleremo velocità, visibilità locale e tracciamenti per dirti con sincerità cosa sistemare.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={SITE.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="pop-btn bg-pop-green text-ink hover:bg-pop-green-hover px-6 py-3.5 text-sm font-bold"
            >
              <Icon name="whatsapp" size={18} />
              Scrivici su WhatsApp
              <span class="text-xs opacity-90">(dialogo diretto)</span>
            </a>
            <a
              href={basePath('/contact')}
              class="pop-btn bg-white text-ink hover:bg-pop-yellow px-6 py-3.5 text-sm font-bold"
            >
              Compila il modulo contatti breve
            </a>
          </div>
        </div>

        <div class="lg:col-span-4 flex justify-center">
          <Mascot name="whatsapp-buddy" size={170} />
        </div>
      </div>
    </div>
  </section>
</Layout>
