---
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import Mascot from '@/components/Mascot.astro';
import Layout from '@/layouts/Layout.astro';
import { getProject } from '@/lib/content';
import { SITE, basePath } from '@/lib/design';
import { TERRITORI, getTerritorio } from '@/data/territori';

export function getStaticPaths() {
  return TERRITORI.map((item) => ({
    params: { slug: item.slug },
    props: { territorio: item },
  }));
}

const { slug } = Astro.params;
const territorio = Astro.props.territorio ?? getTerritorio(slug);

if (!territorio) {
  Astro.response.status = 404;
}

const relatedProject = territorio?.relatedProjectSlug
  ? await getProject(territorio.relatedProjectSlug)
  : null;

const otherTerritori = TERRITORI.filter((t) => t.slug !== slug);
---

{
  !territorio ? (
    <Layout title="Territorio non trovato — BIMAX" noindex>
      <section class="mx-auto flex min-h-[60vh] max-w-[1360px] flex-col items-start justify-center px-[var(--page-gutter)] py-24">
        <h1 class="display-lg text-ink">Territorio non trovato</h1>
        <p class="mt-4 text-ink/75">La pagina territoriale richiesta non esiste.</p>
        <a href={basePath('/')} class="pop-btn bg-pop-coral text-white mt-6">Torna alla home</a>
      </section>
    </Layout>
  ) : (
    <Layout
      title={`Sviluppo Web & Presenza Digitale per PMI a ${territorio.shortName} — BIMAX`}
      description={`Supportiamo le PMI e le attività di ${territorio.name}: siti web veloci, visibilità su Google Maps e tracciamento contatti per far crescere il tuo business.`}
    >
      <!-- Hero Territoriale -->
      <section class="relative overflow-hidden pt-12 pb-18 md:pt-18 md:pb-24 bg-paper">
        <!-- Texture a pois leggeri -->
        <div
          class="pointer-events-none absolute inset-0 opacity-[0.06] [background-image:radial-gradient(var(--color-ink)_2px,transparent_2px)] [background-size:24px_24px]"
          aria-hidden="true"
        ></div>

        <div class="relative mx-auto max-w-[1360px] px-[var(--page-gutter)]">
          <div class="flex flex-wrap items-center gap-2.5 mb-6">
            <a href={basePath('/')} class="pop-badge bg-white text-ink text-xs font-bold hover:bg-pop-yellow">
              ← Home
            </a>
            <span class="pop-badge bg-pop-yellow text-ink text-xs font-bold -rotate-1">
              {territorio.badge}
            </span>
            <span class="pop-badge bg-pop-mint text-ink text-xs font-bold rotate-1">
              Partner per PMI
            </span>
          </div>

          <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
            <div class="lg:col-span-8">
              <h1 class="display-xl max-w-[15ch] text-balance text-ink">
                Sviluppo web e crescita digitale per le PMI a <span class="bg-pop-yellow px-2 py-0.5 rounded-lg border-2 border-ink shadow-pop-sm">{territorio.shortName}</span>
              </h1>

              <p class="mt-6 max-w-[60ch] text-[17px] leading-relaxed text-ink/80 md:text-[18px]">
                {territorio.description}
              </p>

              <!-- Box valore d'agenzia: non solo tecnici -->
              <div class="mt-8 pop-card bg-pop-yellow-soft p-5 max-w-xl">
                <div class="flex items-start gap-3.5">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border-2 border-ink bg-pop-mint text-ink font-bold shadow-pop-sm">
                    ★
                  </span>
                  <div>
                    <p class="font-display text-base font-bold text-ink">
                      La tecnologia è il mezzo, il tuo business è l'obiettivo
                    </p>
                    <p class="mt-1 text-xs text-ink/80 leading-relaxed">
                      Non ci limitiamo a scrivere codice. Analizziamo le necessità della tua impresa, eliminiamo le complicazioni e costruiamo uno strumento affidabile per generare richieste e contatti reali.
                    </p>
                  </div>
                </div>
              </div>

              <div class="mt-8 flex flex-wrap items-center gap-4">
                <a
                  href={SITE.whatsappUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="pop-btn bg-pop-green text-ink hover:bg-pop-green-hover text-sm px-6 py-3.5"
                >
                  <Icon name="whatsapp" size={18} />
                  Parliamo del tuo progetto
                </a>
                <a
                  href={basePath('/contact')}
                  class="pop-btn bg-white text-ink hover:bg-pop-yellow text-sm px-6 py-3.5"
                >
                  Richiedi un audit gratuito
                  <Icon name="arrow-right" size={15} />
                </a>
              </div>
            </div>

            <div class="lg:col-span-4 flex flex-col items-center">
              <div class="pop-card bg-white p-7 text-center w-full max-w-[320px]">
                <Mascot name="scout" size={150} class="mx-auto" />
                <p class="font-display text-lg font-bold text-ink mt-3">
                  Attivi a {territorio.shortName}
                </p>
                <p class="text-xs text-ink/75 mt-2 leading-relaxed">
                  Dialogo diretto con i referenti del progetto. Nessun passaggio commerciale, nessun ticket rimbalzato.
                </p>
                <div class="mt-4 pt-3 border-t-2 border-ink/10 flex items-center justify-center gap-2 text-xs font-mono font-bold text-accent">
                  <Icon name="map-pin" size={14} />
                  {territorio.name}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- I Settori Chiave del Territorio -->
      <section class="border-y-2 border-ink bg-canvas px-[var(--page-gutter)] py-16 md:py-22">
        <div class="mx-auto max-w-[1360px]">
          <div class="max-w-lg">
            <span class="pop-badge bg-ink text-white text-xs font-bold mb-3">
              Settori del territorio
            </span>
            <h2 class="display-lg text-ink mt-2">
              Le realtà aziendali che affianchiamo a {territorio.shortName}
            </h2>
            <p class="mt-3.5 text-[15px] leading-relaxed text-ink/80">
              Ogni settore ha ritmi, clienti e modalità di contatto differenti. Adattiamo l'architettura del sito e i tracciamenti al modello di vendita della tua PMI.
            </p>
          </div>

          <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {territorio.sectors.map((sector, idx) => (
              <div class="pop-card bg-white p-6 flex flex-col justify-between">
                <div>
                  <span class="inline-block font-mono text-xs font-bold text-ink/75 bg-pop-yellow-soft border border-ink/20 px-2 py-0.5 rounded-md mb-3">
                    Settore #{idx + 1}
                  </span>
                  <h3 class="font-display text-base font-bold text-ink">
                    {sector}
                  </h3>
                </div>
                <p class="mt-4 text-xs text-ink/70 pt-3 border-t border-ink/10">
                  Ottimizzazione mobile e canali di richiesta dedicati.
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Problema vs Soluzione per le PMI Locali -->
      <section class="px-[var(--page-gutter)] py-18 md:py-24 bg-paper">
        <div class="mx-auto max-w-[1360px]">
          <div class="grid gap-8 md:grid-cols-2 lg:gap-12">
            <!-- Problema -->
            <div class="pop-card bg-pop-coral-soft p-8 md:p-10">
              <span class="pop-badge bg-pop-coral text-white text-xs font-bold mb-4">
                La sfida frequente
              </span>
              <h2 class="display-md text-2xl font-bold text-ink">
                Cosa rallenta le imprese a {territorio.shortName}?
              </h2>
              <p class="mt-4 max-w-[60ch] text-[15px] leading-relaxed text-ink/85">
                {territorio.challenges}
              </p>
              <div class="mt-6 pt-4 border-t-2 border-ink/15 text-xs font-mono font-bold text-ink">
                <span class="text-pop-coral mr-1.5 font-black">✕</span> Dispersione di tempo e contatti non tracciati
              </div>
            </div>

            <!-- Soluzione -->
            <div class="pop-card bg-pop-mint-soft p-8 md:p-10">
              <span class="pop-badge bg-pop-mint text-ink text-xs font-bold mb-4">
                Il nostro approccio
              </span>
              <h2 class="display-md text-2xl font-bold text-ink">
                Come interveniamo come partner
              </h2>
              <p class="mt-4 max-w-[60ch] text-[15px] leading-relaxed text-ink/85">
                {territorio.solution}
              </p>
              <div class="mt-6 pt-4 border-t-2 border-ink/15 text-xs font-mono font-bold text-ink">
                <span class="font-black mr-1.5">✓</span> Strumenti leggeri, misurabili e facili da usare
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Sezione Presenza Locale & Visibilità (senza false promesse) -->
      <section class="border-y-2 border-ink bg-pop-yellow-soft px-[var(--page-gutter)] py-16 md:py-22">
        <div class="mx-auto max-w-[1360px]">
          <div class="max-w-lg">
            <span class="pop-badge bg-pop-yellow text-ink text-xs font-bold mb-3">
              Visibilità & Google Maps
            </span>
            <h2 class="display-lg text-ink mt-2">
              Migliorare la presenza locale, con onestà e senza false promesse
            </h2>
            <p class="mt-3.5 text-[15px] leading-relaxed text-ink/80">
              Non ti promettiamo il "primo posto magico" su Google: chi lo fa sta vendendo fumo. Quello che facciamo è un lavoro tecnico scrupoloso per migliorare sensibilmente la visibilità della tua azienda e la reperibilità da chi cerca i tuoi servizi a {territorio.shortName}.
            </p>
          </div>

          <div class="mt-10 grid gap-6 md:grid-cols-3">
            <div class="pop-card bg-white p-7">
              <div class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-xl border-2 border-ink bg-pop-mint text-ink font-bold">
                  📍
                </span>
                <h3 class="font-display text-lg font-bold text-ink">
                  Scheda Google Maps curata
                </h3>
              </div>
              <p class="mt-3 text-[14px] leading-relaxed text-ink/75">
                Allineamento di categorie, orari, aree coperte e fotografie professionali per trasmettere serietà a chi naviga nella tua zona.
              </p>
            </div>

            <div class="pop-card bg-white p-7">
              <div class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-xl border-2 border-ink bg-pop-yellow text-ink font-bold">
                  🏷️
                </span>
                <h3 class="font-display text-lg font-bold text-ink">
                  Dati geografici precisi
                </h3>
              </div>
              <p class="mt-3 text-[14px] leading-relaxed text-ink/75">
                Integrazione di dati strutturati (Schema.org) sul sito per far comprendere ai motori di ricerca il territorio reale in cui opera la tua attività.
              </p>
            </div>

            <div class="pop-card bg-white p-7">
              <div class="flex items-center gap-3">
                <span class="grid h-10 w-10 place-items-center rounded-xl border-2 border-ink bg-pop-purple text-white font-bold">
                  📊
                </span>
                <h3 class="font-display text-lg font-bold text-ink">
                  Tracciamento reale
                </h3>
              </div>
              <p class="mt-3 text-[14px] leading-relaxed text-ink/75">
                Misurazione chiara dei click sul numero di telefono, sui messaggi WhatsApp e sui moduli per sapere esattamente quante opportunità arrivano dal sito.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Progetto correlato se presente -->
      {relatedProject && (
        <section class="px-[var(--page-gutter)] py-16 md:py-22 bg-paper border-b-2 border-ink">
          <div class="mx-auto max-w-[1360px]">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
              <div>
                <span class="pop-badge bg-pop-mint text-ink text-xs font-bold mb-3">
                  Caso Studio Correlato
                </span>
                <h2 class="display-lg text-ink mt-2">
                  Un esempio concreto dal territorio
                </h2>
              </div>
              <a href={basePath(`/projects/${relatedProject.slug}`)} class="pop-btn bg-white text-ink text-xs px-5 py-2.5">
                Leggi l'articolo completo
                <Icon name="arrow-right" size={14} />
              </a>
            </div>

            <div class="pop-card bg-canvas p-8 md:p-10 flex flex-col md:flex-row items-center gap-8">
              {relatedProject.coverUrl && (
                <div class="w-full md:w-1/2 overflow-hidden rounded-2xl border-2 border-ink shadow-pop">
                  <img
                    src={relatedProject.coverUrl}
                    alt={relatedProject.title}
                    width="600"
                    height="400"
                    class="w-full aspect-[16/10] object-cover"
                  />
                </div>
              )}
              <div class="w-full md:w-1/2">
                <span class="pop-badge bg-white text-ink text-xs font-bold mb-2">
                  {relatedProject.client}
                </span>
                <h3 class="display-md text-2xl font-bold text-ink mt-2">
                  {relatedProject.title}
                </h3>
                <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-ink/80">
                  {relatedProject.summary}
                </p>
                <div class="mt-6 flex flex-wrap gap-2">
                  {(relatedProject.tags ?? []).map((tag) => (
                    <span class="rounded bg-white px-2.5 py-1 font-mono text-xs font-bold text-ink border border-ink/20">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>
      )}

      <!-- Navigazione altri territori -->
      <section class="px-[var(--page-gutter)] py-14 bg-canvas">
        <div class="mx-auto max-w-[1360px]">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.14em] text-ink/75 mb-4">
            Scopri gli altri presidi territoriali per le PMI:
          </p>
          <div class="flex flex-wrap items-center gap-3">
            {otherTerritori.map((other) => (
              <a
                href={basePath(`/territorio/${other.slug}`)}
                class="pop-badge bg-white text-ink hover:bg-pop-yellow transition-colors text-xs font-bold"
              >
                📍 {other.shortName}
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA Finale Territoriale -->
      <CtaBand
        title={`Parliamo della tua attività a ${territorio.shortName}`}
        description="Hai un sito web che non genera contatti o una presenza online da riorganizzare? Scrivici: controlleremo la situazione tecnica e locale per darti indicazioni chiare e concrete."
        primary={{ label: 'Scrivici su WhatsApp', href: SITE.whatsappUrl, isExternal: true }}
        secondary={{ label: 'Compila il modulo rapido', href: basePath('/contact') }}
      />
    </Layout>
  )
}
